# Threshold configuration for system_monitor.sh
# Copy this file to "config.env" and edit values as needed.

CPU_THRESHOLD=85        # percent (warn if CPU usage >= this)
MEMORY_THRESHOLD=80     # percent (used memory)
DISK_THRESHOLD=80       # percent (used)
INODE_THRESHOLD=80      # percent (used)
# Default log file (repo-relative default; users can change to an absolute path)
LOG_FILE="$HOME/Linux-System-Monitoring-and-Log-Analysis/logs/system_monitor.log"
# Optional: number of top processes to record
TOP_N=5
